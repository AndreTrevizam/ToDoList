<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ToDoList.Desktop.ViewModels.Auth"
             x:Class="ToDoList.Desktop.Views.Auth.LoginView"
             x:DataType="vm:LoginViewModel">
    <StackPanel Width="300" Spacing="12"
                HorizontalAlignment="Center" VerticalAlignment="Center">

          <TextBlock Text="Login" FontSize="24" />
          <TextBox Watermark="Email" Text="{Binding Email}" />
          <TextBox Watermark="Senha" PasswordChar="*" Text="{Binding Password}" />

          <TextBlock Text="{Binding ErrorMessage}" Foreground="Red"
                      IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          
          <Button Content="Entrar"
                  Command="{Binding LoginCommand}"
                  IsEnabled="{Binding !IsBusy}"
                  HorizontalAlignment="Stretch" />

    </StackPanel>
</UserControl>